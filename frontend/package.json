{
  "name": "covision_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "submit:ios": "eas build --platform ios --auto-submit",
    "local:android": "expo run:android -- --device",
    "local:ios": "expo run:ios -- --device",
    "build-preview:android": "eas build --platform android --profile preview",
    "build-preview:ios": "eas build --platform ios --profile preview",
    "build-production:android": "eas build --platform android --profile production",
    "build-production:ios": "eas build --platform ios --profile production",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/app-example/"
    ]
  },
  "dependencies": {
    "@expo/server": "^0.5.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "@shopify/react-native-skia": "2.5.5",
    "@testing-library/react": "^16.3.2",
    "expo": "54.0.20",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.16",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.13",
    "expo-speech": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.8",
    "jotai": "^2.15.0",
    "openai": "^5.23.2",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-fast-opencv": "^0.4.8",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-vision-camera-v3-image-labeling": "^1.5.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "vision-camera-resize-plugin": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "@types/react-test-renderer": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "jpeg-js": "^0.4.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "private": true,
  "packageManager": "pnpm@10.20.0"
}
